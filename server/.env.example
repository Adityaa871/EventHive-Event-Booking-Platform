NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/eventhive
# For Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventhive
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Used by the seed script
ADMIN_NAME=EventHive Admin
ADMIN_EMAIL=admin@eventhive.com
ADMIN_PASSWORD=Admin@12345

# Email Notifications (Nodemailer SMTP - optional, simulates in console if omitted)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="EventHive Concierge" <noreply@eventhive.com>

# AI Event Assistant (Google Gemini API - optional, uses rule-based fallback if omitted)
GEMINI_API_KEY=your_gemini_api_key_here
