{
  "info": {
    "_postman_id": "b3e94182-140a-422f-870a-f027e4e1a0b5",
    "name": "EventHive REST API",
    "description": "Postman Collection for EventHive Event Booking Platform API endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "packageId",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@eventhive.com\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Admin Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Packages",
      "item": [
        {
          "name": "List Packages (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/packages?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["packages"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Filter Packages by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/packages?category=wedding",
              "host": ["{{baseUrl}}"],
              "path": ["packages"],
              "query": [
                { "key": "category", "value": "wedding" }
              ]
            }
          }
        },
        {
          "name": "Search Packages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/packages?search=wedding",
              "host": ["{{baseUrl}}"],
              "path": ["packages"],
              "query": [
                { "key": "search", "value": "wedding" }
              ]
            }
          }
        },
        {
          "name": "Get Package by ID or Slug",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/packages/royal-wedding-package",
              "host": ["{{baseUrl}}"],
              "path": ["packages", "royal-wedding-package"]
            }
          }
        },
        {
          "name": "Create Package (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Luxury Beachside Gathering\",\n  \"slug\": \"luxury-beachside-gathering\",\n  \"category\": \"other\",\n  \"shortDescription\": \"An exquisite sunset gathering with seaside dining and bonfire.\",\n  \"description\": \"Full service beachside party setup including acoustic music, bonfire, gourmet seafood barbecue, and customized lounge seating.\",\n  \"price\": 110000,\n  \"capacity\": 60,\n  \"duration\": \"6 hours\",\n  \"inclusions\": [\n    \"Beachside Lounge Seating\",\n    \"Acoustic Duo\",\n    \"BBQ Buffet\",\n    \"Bonfire & Lighting\"\n  ],\n  \"images\": [\n    \"https://images.unsplash.com/photo-1519671482749-fd09be7ccebf?w=800\"\n  ],\n  \"isFeatured\": true,\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/packages",
              "host": ["{{baseUrl}}"],
              "path": ["packages"]
            }
          }
        },
        {
          "name": "Update Package (Admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 120000,\n  \"shortDescription\": \"Updated beachside celebration with premier catering.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/packages/{{packageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["packages", "{{packageId}}"]
            }
          }
        },
        {
          "name": "Delete Package (Admin Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/packages/{{packageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["packages", "{{packageId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Submit Booking Lead (Public)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Riya Verma\",\n  \"email\": \"riya@example.com\",\n  \"phone\": \"9876543210\",\n  \"eventType\": \"wedding\",\n  \"eventDate\": \"2026-12-12\",\n  \"guestCount\": 250,\n  \"venue\": \"Mathura\",\n  \"budget\": 800000,\n  \"message\": \"Need floral decoration and live music.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            }
          }
        },
        {
          "name": "Get Booking Stats Summary (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/stats/summary",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "stats", "summary"]
            }
          }
        },
        {
          "name": "List All Bookings (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings?status=new&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"],
              "query": [
                { "key": "status", "value": "new" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get Single Booking (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "{{bookingId}}"]
            }
          }
        },
        {
          "name": "Update Booking Status & Notes (Admin)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"contacted\",\n  \"adminNotes\": \"Client contacted by phone. Planning consultation scheduled for Friday.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "{{bookingId}}"]
            }
          }
        },
        {
          "name": "Delete Booking (Admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "{{bookingId}}"]
            }
          }
        }
      ]
    }
  ]
}

